<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_processo_ferias" targetNamespace="urn:process-design:preview">
  <bpmn:process id="processo_ferias" name="Solicitação de Férias" isExecutable="false">
    <bpmn:startEvent id="inicio" name="Pedido de férias">
      <bpmn:outgoing>fl_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="aprovacao" name="Analisar solicitação">
      <bpmn:incoming>fl_1</bpmn:incoming>
      <bpmn:outgoing>fl_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="decisao" name="Aprovado?">
      <bpmn:incoming>fl_2</bpmn:incoming>
      <bpmn:outgoing>fl_3</bpmn:outgoing>
      <bpmn:outgoing>fl_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="registro" name="Registrar férias no RH">
      <bpmn:incoming>fl_3</bpmn:incoming>
      <bpmn:outgoing>fl_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="notificar" name="Comunicar rejeição">
      <bpmn:documentation>PREVIEW-ONLY: notification.send via notification_mock/notify_rejection; configs no ProcessSpec, execução DESATIVADA.</bpmn:documentation>
      <bpmn:incoming>fl_4</bpmn:incoming>
      <bpmn:outgoing>fl_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fim" name="Processo encerrado">
      <bpmn:incoming>fl_5</bpmn:incoming>
      <bpmn:incoming>fl_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_1" sourceRef="inicio" targetRef="aprovacao" />
    <bpmn:sequenceFlow id="fl_2" sourceRef="aprovacao" targetRef="decisao" />
    <bpmn:sequenceFlow id="fl_3" sourceRef="decisao" targetRef="registro" name="Aprovado">
      <bpmn:documentation>CONDITION AST (preview): {"left": {"var": "decision"}, "op": "eq", "right": {"literal": "approved"}}</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_4" sourceRef="decisao" targetRef="notificar" name="Rejeitado">
      <bpmn:documentation>CONDITION AST (preview): {"left": {"var": "decision"}, "op": "eq", "right": {"literal": "rejected"}}</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_5" sourceRef="registro" targetRef="fim" />
    <bpmn:sequenceFlow id="fl_6" sourceRef="notificar" targetRef="fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_processo_ferias">
    <bpmndi:BPMNPlane id="Plane_processo_ferias" bpmnElement="processo_ferias">
      <bpmndi:BPMNShape id="Shape_inicio" bpmnElement="inicio">
        <dc:Bounds x="110" y="130.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_aprovacao" bpmnElement="aprovacao">
        <dc:Bounds x="320" y="130.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_decisao" bpmnElement="decisao">
        <dc:Bounds x="530" y="130.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_registro" bpmnElement="registro">
        <dc:Bounds x="740" y="40.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_notificar" bpmnElement="notificar">
        <dc:Bounds x="740" y="220.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_fim" bpmnElement="fim">
        <dc:Bounds x="950" y="130.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_fl_1" bpmnElement="fl_1">
        <di:waypoint x="146" y="148.0" />
        <di:waypoint x="233.0" y="148.0" />
        <di:waypoint x="233.0" y="170.0" />
        <di:waypoint x="320" y="170.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fl_2" bpmnElement="fl_2">
        <di:waypoint x="460" y="170.0" />
        <di:waypoint x="495.0" y="170.0" />
        <di:waypoint x="495.0" y="155.0" />
        <di:waypoint x="530" y="155.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fl_3" bpmnElement="fl_3">
        <di:waypoint x="580" y="155.0" />
        <di:waypoint x="660.0" y="155.0" />
        <di:waypoint x="660.0" y="80.0" />
        <di:waypoint x="740" y="80.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fl_4" bpmnElement="fl_4">
        <di:waypoint x="580" y="155.0" />
        <di:waypoint x="660.0" y="155.0" />
        <di:waypoint x="660.0" y="260.0" />
        <di:waypoint x="740" y="260.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fl_5" bpmnElement="fl_5">
        <di:waypoint x="880" y="80.0" />
        <di:waypoint x="915.0" y="80.0" />
        <di:waypoint x="915.0" y="148.0" />
        <di:waypoint x="950" y="148.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_fl_6" bpmnElement="fl_6">
        <di:waypoint x="880" y="260.0" />
        <di:waypoint x="915.0" y="260.0" />
        <di:waypoint x="915.0" y="148.0" />
        <di:waypoint x="950" y="148.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>