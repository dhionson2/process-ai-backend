{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/process-spec.v1.schema.json",
  "title": "ProcessSpec v1 — contrato de modelagem independente do motor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "locale",
    "targetProfile",
    "status",
    "roles",
    "variables",
    "forms",
    "nodes",
    "flows",
    "pendingQuestions",
    "assumptions",
    "policies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "locale": {
      "const": "pt-BR"
    },
    "targetProfile": {
      "enum": [
        "generic-bpmn2",
        "flowable-oss",
        "unique-future"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "needs-input",
        "invalid",
        "ready-for-review",
        "approved"
      ]
    },
    "roles": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "resolution": {
            "enum": [
              "requester",
              "manual",
              "group",
              "manager-of-requester",
              "system"
            ]
          },
          "groupKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "forms": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "usage",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "usage": {
            "enum": [
              "start",
              "task"
            ]
          },
          "fields": {
            "type": "array",
            "maxItems": 300,
            "items": {
              "$ref": "#/$defs/field"
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "maxLength": 255
          },
          "condition": {
            "$ref": "#/$defs/expression"
          },
          "isDefault": {
            "type": "boolean"
          }
        }
      }
    },
    "pendingQuestions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "blocking": {
            "type": "boolean"
          },
          "relatedNodeId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "confirmed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "confirmed": {
            "type": "boolean"
          },
          "origin": {
            "enum": [
              "user",
              "catalog",
              "inference",
              "example"
            ]
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manualApprovalRequired",
        "allowExecution"
      ],
      "properties": {
        "manualApprovalRequired": {
          "const": true
        },
        "allowExecution": {
          "const": false
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledgeVersion": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "var"
          ],
          "properties": {
            "var": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "enum": [
                "not",
                "isSet"
              ]
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type",
        "required",
        "bindTo"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "integer",
            "decimal",
            "boolean",
            "select",
            "date",
            "datetime",
            "email",
            "attachment"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "bindTo": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "sensitive": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "value": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        },
        "visibleWhen": {
          "$ref": "#/$defs/expression"
        },
        "requiredWhen": {
          "$ref": "#/$defs/expression"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "pattern": {
          "type": "string",
          "maxLength": 150
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "required",
        "sensitive",
        "scope",
        "source"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "object",
            "array"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "process",
            "task"
          ]
        },
        "enumValues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "form",
                "action",
                "constant",
                "system"
              ]
            },
            "formId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            },
            "fieldKey": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            },
            "nodeId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            },
            "outputKey": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            },
            "systemKey": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "type": {
          "enum": [
            "startEvent",
            "endEvent",
            "userTask",
            "serviceTask",
            "manualTask",
            "businessRuleTask",
            "sendTask",
            "receiveTask",
            "scriptTask",
            "exclusiveGateway",
            "parallelGateway",
            "inclusiveGateway",
            "eventBasedGateway",
            "intermediateCatchEvent",
            "intermediateThrowEvent",
            "boundaryEvent",
            "subProcess",
            "callActivity"
          ]
        },
        "documentation": {
          "type": "string",
          "maxLength": 10000
        },
        "roleId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "formId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "defaultFlowId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "eventDefinition": {
          "enum": [
            "none",
            "message",
            "timer",
            "signal",
            "error",
            "escalation",
            "terminate",
            "compensation",
            "link"
          ]
        },
        "attachedToNodeId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "calledProcessId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "extensionData": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "backoffMs"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "backoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "connectorId",
        "operationId",
        "inputMapping",
        "outputMapping",
        "timeoutMs",
        "retryPolicy",
        "sideEffectLevel"
      ],
      "properties": {
        "capability": {
          "enum": [
            "http.request",
            "database.record.read",
            "database.record.create",
            "database.record.update",
            "database.record.delete",
            "notification.send",
            "document.generate",
            "document.sign.request",
            "queue.publish",
            "data.transform",
            "process.call",
            "rules.evaluate",
            "file.store"
          ]
        },
        "connectorId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "inputMapping": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        },
        "outputMapping": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 128
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "retryPolicy": {
          "$ref": "#/$defs/retryPolicy"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/expression"
        },
        "sideEffectLevel": {
          "enum": [
            "read",
            "write",
            "irreversible"
          ]
        },
        "approvalRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
