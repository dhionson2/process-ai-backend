{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "questions"
      ],
      "properties": {
        "kind": {
          "const": "need_clarification"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "blocking"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "blocking": {
                "type": "boolean"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spec",
        "changeSummary"
      ],
      "properties": {
        "kind": {
          "const": "proposed_spec"
        },
        "spec": {
          "type": "object"
        },
        "changeSummary": {
          "type": "string"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  ]
}
