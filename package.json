{
  "name": "process-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "inspect:groq-schema": "node --env-file-if-exists=.env --import tsx scripts/inspect-groq-structured-schema.ts",
    "generate:examples": "node --import tsx src/modules/generation/artifact-generator.ts",
    "evaluate:ollama": "node --env-file-if-exists=.env --import tsx scripts/evaluate-local-ollama.ts",
    "evaluate:business-intent": "node --env-file-if-exists=.env --import tsx scripts/evaluate-business-intent-ollama.ts",
    "benchmark:groq": "node --env-file-if-exists=.env --import tsx scripts/benchmark-groq.ts",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/eval/run-eval.ts",
    "eval:claude": "node --env-file-if-exists=.env --import tsx scripts/eval/run-eval.ts --provider claude-cli --model sonnet --approve-external",
    "eval:scoreboard": "node --import tsx scripts/eval/run-eval.ts --rebuild"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "ajv": "^8.17.1",
    "fastify": "^5.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@bpmn-io/form-js-editor": "^2.1.1",
    "@bpmn-io/form-js-viewer": "^2.1.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "bpmn-js": "^18.31.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
