  <bpmn:process id="process_processo_de_ferias" name="Processo de férias" isExecutable="false">
    <bpmn:startEvent id="start_processo_de_ferias" name="Processo de férias" flowable:formKey="form_processo_de_ferias_request">
      <bpmn:outgoing>flow_0007</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_process_finished" name="Processo encerrado">
      <bpmn:incoming>flow_0002</bpmn:incoming>
      <bpmn:incoming>flow_0003</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_aprovar_ferias" name="Aprovar férias" flowable:formKey="form_aprovar_ferias">
      <bpmn:incoming>flow_0006</bpmn:incoming>
      <bpmn:outgoing>flow_0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_aprovar_ferias" name="Aprovar férias" gatewayDirection="Diverging">
      <bpmn:incoming>flow_0001</bpmn:incoming>
      <bpmn:outgoing>flow_0004</bpmn:outgoing>
      <bpmn:outgoing>flow_0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_registrar_ferias" name="Registrar férias">
