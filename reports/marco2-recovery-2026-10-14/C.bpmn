      <bpmn:outgoing>flow_0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_informar_periodo_de_ferias" name="Informar período de férias">
      <bpmn:incoming>flow_0007</bpmn:incoming>
      <bpmn:outgoing>flow_0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_segunda_aprovacao" name="Segunda aprovação" flowable:formKey="form_segunda_aprovacao">
      <bpmn:incoming>flow_0004</bpmn:incoming>
      <bpmn:outgoing>flow_task_segunda_aprovacao_gateway_segunda_aprov</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_segunda_aprovacao" name="Segunda aprovação" gatewayDirection="Diverging">
