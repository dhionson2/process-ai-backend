# Desenvolvimento local. Não exponha publicamente sem autenticação e política de acesso.
HOST=127.0.0.1
PORT=3333
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOCAL_TENANT_ID=local-dev

# Configure PostgreSQL para projetos e conversas.
POSTGRES_DB=process_ai
POSTGRES_USER=process_ai
POSTGRES_PASSWORD=replace-with-local-development-password
DATABASE_URL=postgresql://process_ai:replace-with-local-development-password@127.0.0.1:5432/process_ai
TEST_DATABASE_URL=postgresql://process_ai:replace-with-local-development-password@127.0.0.1:5432/process_ai

# Ollama local. O modelo deve estar disponível no daemon Ollama.
AI_PROVIDER=disabled
# AI_PROVIDER=ollama
# Modelo local avaliado nesta fase: ollama pull qwen2.5:3b-instruct
# AI_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_MS=60000
AI_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARS=40000
AI_MAX_CONCURRENCY=2
EXTERNAL_AI_STRUCTURED_OUTPUT=json-object
# Limites locais opcionais por instância do adaptador externo (0 = sem limite).
AI_MAX_PROVIDER_CALLS=0
AI_MAX_PROVIDER_TOKENS=0
AI_SEMANTIC_GROUNDING_MODE=legacy
AI_GRAPH_IR_MODE=off

# Adaptador externo compatível com OpenAI: manter desligado salvo aprovação operacional.
# AI_PROVIDER=openai-compatible
# EXTERNAL_AI_APPROVED=true
# EXTERNAL_AI_BASE_URL=https://provider.example/v1
# EXTERNAL_AI_API_KEY=
# AI_MODEL=approved-model
# EXTERNAL_AI_API_KEY=configure-locally

# Claude Code CLI local (provedor externo; demo/POC). Usa o login do `claude` instalado na máquina.
# Para piloto com chave corporativa: CLAUDE_CLI_BARE=true e ANTHROPIC_API_KEY fornecida por mecanismo aprovado.
# AI_PROVIDER=claude-cli
# EXTERNAL_AI_APPROVED=true
# AI_MODEL=sonnet
# CLAUDE_CLI_BINARY=claude
# CLAUDE_CLI_BARE=false
# CLAUDE_CLI_MAX_BUDGET_USD=0.25

# API Anthropic (provedor externo; caminho do piloto). O SDK lê ANTHROPIC_API_KEY de mecanismo aprovado,
# nunca deste arquivo. Saída estruturada + cache do system/prefixo + fallback de recusa no servidor.
# AI_PROVIDER=anthropic
# EXTERNAL_AI_APPROVED=true
# AI_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACKS=default
# ANTHROPIC_MAX_RETRIES=2

# Cascata de modelos: chamadas de correção escalam para este modelo (qualquer provider).
# AI_REPAIR_MODEL=claude-opus-5-5

# OpenTelemetry (opcional): spans por turno via OTLP/HTTP, por exemplo para o agente Datadog.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=process-ai-backend

# Segurança para piloto (ADR-011). Local: AUTH_MODE=off usa LOCAL_TENANT_ID.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.exemplo/realms/process-ai
# OIDC_AUDIENCE=process-ai-backend
# OIDC_JWKS_URL=            # opcional; padrão: descoberta em ${OIDC_ISSUER}/.well-known/openid-configuration
# OIDC_TENANT_CLAIM=tenant
# OIDC_ROLES_CLAIM=roles
# OIDC_WRITE_ROLE=process-designer
# PII_MASKING=on
# TURN_RATE_LIMIT_PER_MINUTE=30
